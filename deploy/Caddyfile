# Caddy in front of the website and its API (see README.md): one address for both, over HTTPS, behind a temporary
# shared password. deploy.sh installs it as /etc/caddy/Caddyfile and reloads Caddy when it changes.

(site) {
	# Until the site has logins of its own, one shared user name and password for everything. Caddy reads them from
	# /etc/caddy/site.env, which deploy.sh makes; root can read the password itself in /etc/caddy/site-password.
	basic_auth {
		{$SITE_USER} {$SITE_PASSWORD_HASH}
	}

	# Each request's ID: the API takes it as its own, so Caddy's log, the API's and an error the site shows agree
	request_header X-Request-ID {http.request.uuid}
	log_append request_id {http.request.uuid}

	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	# Taking a header away waits until an answer is written, so answers that end in an error (no password, the API
	# down) still name Caddy; the others name nothing
	header -Server

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}

	# Each request as a JSON line in Caddy's journal (journalctl -u caddy), without the password
	log
}

# The server's own address, until it has a domain: then the domain goes here instead (pointed at this address)
198.163.196.164 {
	# Let's Encrypt's certificates for an IP address are short-lived (about 6 days); Caddy renews them by itself
	tls {
		issuer acme {
			profile shortlived
		}
	}
	import site
}

# The same site on this machine only, without HTTPS: for checks from the server itself
http://127.0.0.1:8080 {
	bind 127.0.0.1
	import site
}
