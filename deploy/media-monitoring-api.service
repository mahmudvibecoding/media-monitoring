# The web API (see README.md), from the release /opt/media-monitoring/current points to, on 127.0.0.1:8000. It runs as
# media_monitoring_api, whose database user can only read. deploy.sh installs and restarts it.
[Unit]
Description=Media monitoring: web API
After=network.target postgresql.service

[Service]
User=media_monitoring_api
WorkingDirectory=/opt/media-monitoring/current
ExecStart=/opt/media-monitoring/current/.venv/bin/api
Restart=always
RestartSec=2

# Locked down: the system is read-only to it; it can't see /root, /home or other processes, gain privileges, or reach
# anything but this machine (the database's socket and its own port)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

[Install]
WantedBy=multi-user.target
